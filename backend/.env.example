PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Atlas/Replica Set URI
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/yourdreamcar?retryWrites=true&w=majority

# Use a strong random secret in production
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated or single frontend URL, or * for all origins
CORS_ORIGIN=*

# Cloudinary (required for image upload routes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: create a default user on boot (not recommended in production)
SEED_USER_ON_BOOT=false
SEED_USER_EMAIL=gafru@yourdreamcar.app
SEED_USER_PASSWORD=DreamCar2026!

# Optional API list caps (protect DB from very large list responses)
# CARS_LIST_LIMIT=200
# EXPENSES_LIST_LIMIT=300
PORT=5000

# MongoDB — local:
# MONGODB_URI=mongodb://127.0.0.1:27017/yourdreamcar
#
# MongoDB Atlas (use your user, password, cluster host, and DB name in the path):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yourdreamcar?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/yourdreamcar

# Required for POST /api/auth/login (JWT signing)
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Optional — first login user (defaults in src/seed/seedUser.js)
# SEED_USER_EMAIL=gafru@yourdreamcar.app
# SEED_USER_PASSWORD=DreamCar2026!

# Required for car image upload on /api/cars (and /api/upload/image)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional performance (Mongo pool & car summary cache TTL ms)
# MONGO_MAX_POOL=25
# MONGO_MIN_POOL=2
# CARS_SUMMARY_CACHE_MS=45000
